POSTGRES_DB=mevak
POSTGRES_USER=mevak
POSTGRES_PASSWORD=change_this_in_prod
APP_BASE_URL=http://localhost:5000
# La primera cuenta (la de la dueña). Obligatorias: el compose no arranca sin ellas.
# Solo se usan si la base está vacía; después se cambia desde la app.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Zona horaria del centro. El día de la app se calcula en local (ADR-0004).
TZ=America/Mexico_City

# Días que dura una sesión antes de pedir otra vez la contraseña.
TOKEN_TTL_DAYS=30

# Puertos que se publican en la máquina anfitriona.
# En macOS el 5000 lo ocupa AirPlay: usa APP_PORT=5050.
APP_PORT=5000
DB_PORT=5432
